<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AiBoxDashboard.ViewModels"
        xmlns:c="using:AiBoxDashboard.Controls"
        x:Class="AiBoxDashboard.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="AI Box Dashboard"
        Width="1080" Height="700" MinWidth="820" MinHeight="560">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="PageBrush" Color="#F3F4F6" />
                    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#E1E4E8" />
                    <SolidColorBrush x:Key="MutedBrush" Color="#5B6370" />
                    <SolidColorBrush x:Key="LineBrush" Color="#2C6FBB" />
                    <SolidColorBrush x:Key="AreaBrush" Color="#1F2C6FBB" />
                    <SolidColorBrush x:Key="OnBrush" Color="#1E8E4E" />
                    <SolidColorBrush x:Key="OffBrush" Color="#A9AFB8" />
                    <SolidColorBrush x:Key="ErrorBrush" Color="#B3261E" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="PageBrush" Color="#17191C" />
                    <SolidColorBrush x:Key="CardBrush" Color="#212428" />
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#32363C" />
                    <SolidColorBrush x:Key="MutedBrush" Color="#A3AAB5" />
                    <SolidColorBrush x:Key="LineBrush" Color="#6BB0F5" />
                    <SolidColorBrush x:Key="AreaBrush" Color="#266BB0F5" />
                    <SolidColorBrush x:Key="OnBrush" Color="#4CC47E" />
                    <SolidColorBrush x:Key="OffBrush" Color="#6A717C" />
                    <SolidColorBrush x:Key="ErrorBrush" Color="#F2857D" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="TextBlock.value">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.heading">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.error">
            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="c|Sparkline">
            <Setter Property="Height" Value="44" />
            <Setter Property="Margin" Value="0,10,0,0" />
            <Setter Property="Stroke" Value="{DynamicResource LineBrush}" />
            <Setter Property="Fill" Value="{DynamicResource AreaBrush}" />
        </Style>
        <Style Selector="Ellipse.dot">
            <Setter Property="Width" Value="9" />
            <Setter Property="Height" Value="9" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{DynamicResource OffBrush}" />
        </Style>
        <Style Selector="Ellipse.dot.on">
            <Setter Property="Fill" Value="{DynamicResource OnBrush}" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,*" Background="{DynamicResource PageBrush}">

        <!-- Header: what is being watched, and where to change it -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="20,18,20,0">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding GpuName}" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Classes="muted" Text="{Binding MachineText}" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <StackPanel Spacing="3">
                    <TextBlock Classes="muted" Text="Ollama address" />
                    <TextBox Width="230" Text="{Binding OllamaUrl}" />
                </StackPanel>
                <StackPanel Spacing="3">
                    <TextBlock Classes="muted" Text="SSH host (empty = this machine)" />
                    <TextBox Width="200" Text="{Binding SshHost}" />
                </StackPanel>
                <Button Content="Connect" VerticalAlignment="Bottom" Command="{Binding ApplyConnectionCommand}" />
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="1" Classes="error" Margin="20,10,20,0" Text="{Binding ConnectionError}"
                   IsVisible="{Binding ConnectionError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <!-- GPU readings, each with the last four minutes -->
        <StackPanel Grid.Row="2" Margin="20,14,20,0" Spacing="8">
            <Grid ColumnDefinitions="*,12,*,12,*,12,*">
                <Border Grid.Column="0" Classes="card">
                    <StackPanel>
                        <TextBlock Classes="muted" Text="Temperature" />
                        <TextBlock Classes="value" Text="{Binding TemperatureText}" />
                        <TextBlock Classes="muted" Text="scale 0–100 °C" />
                        <c:Sparkline Values="{Binding TemperatureHistory}" Minimum="0" Maximum="100" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Classes="card">
                    <StackPanel>
                        <TextBlock Classes="muted" Text="GPU load" />
                        <TextBlock Classes="value" Text="{Binding UtilizationText}" />
                        <TextBlock Classes="muted" Text="scale 0–100 %" />
                        <c:Sparkline Values="{Binding UtilizationHistory}" Minimum="0" Maximum="100" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Classes="card">
                    <StackPanel>
                        <TextBlock Classes="muted" Text="Video memory in use" />
                        <TextBlock Classes="value" Text="{Binding MemoryText}" />
                        <TextBlock Classes="muted" Text="{Binding MemoryDetail}" />
                        <c:Sparkline Values="{Binding MemoryHistory}" Minimum="0" Maximum="{Binding MemoryTotal}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="6" Classes="card">
                    <StackPanel>
                        <TextBlock Classes="muted" Text="Power draw" />
                        <TextBlock Classes="value" Text="{Binding PowerText}" />
                        <TextBlock Classes="muted" Text="last 4 minutes" />
                        <c:Sparkline Values="{Binding PowerHistory}" Minimum="0" Maximum="{Binding PowerMaximum}" />
                    </StackPanel>
                </Border>
            </Grid>
            <TextBlock Classes="error" Text="{Binding GpuMessage}"
                       IsVisible="{Binding GpuMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>

        <!-- Models and containers -->
        <Grid Grid.Row="3" ColumnDefinitions="3*,12,2*" Margin="20,14,20,20">
            <Border Grid.Column="0" Classes="card">
                <Grid RowDefinitions="Auto,Auto,*">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="heading" Text="Models" />
                        <TextBlock Grid.Column="1" Classes="muted" VerticalAlignment="Center" Text="{Binding OllamaStatus}" />
                    </Grid>
                    <TextBlock Grid.Row="1" Classes="muted" TextWrapping="Wrap" Margin="0,10,0,0" Text="{Binding ModelsMessage}"
                               IsVisible="{Binding ModelsMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <ScrollViewer Grid.Row="2" Margin="0,8,0,0">
                        <ItemsControl ItemsSource="{Binding Models}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ModelRow">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,8">
                                        <Ellipse Classes="dot" Classes.on="{Binding IsLoaded}" Margin="0,0,12,0" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Classes="muted" Text="{Binding Details}" />
                                            <TextBlock Classes="muted" Text="{Binding LoadedText}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding SpeedText}" VerticalAlignment="Center"
                                                   Margin="12,0" MaxWidth="220" TextWrapping="Wrap" />
                                        <Button Grid.Column="3" Content="Measure speed" VerticalAlignment="Center"
                                                Command="{Binding MeasureSpeedCommand}"
                                                IsEnabled="{Binding !IsMeasuring}"
                                                ToolTip.Tip="Generates a short text to measure tokens per second. Loads the model into GPU memory if it is not loaded." />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="2" Classes="card">
                <Grid RowDefinitions="Auto,Auto,*">
                    <TextBlock Classes="heading" Text="Containers" />
                    <TextBlock Grid.Row="1" Classes="muted" TextWrapping="Wrap" Margin="0,10,0,0" Text="{Binding ContainersMessage}"
                               IsVisible="{Binding ContainersMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <ScrollViewer Grid.Row="2" Margin="0,8,0,0">
                        <ItemsControl ItemsSource="{Binding Containers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ContainerRow">
                                    <Grid ColumnDefinitions="Auto,*" Margin="0,8">
                                        <Ellipse Classes="dot" Classes.on="{Binding IsRunning}" Margin="0,0,12,0" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Classes="muted" Text="{Binding Status}" />
                                            <TextBlock Classes="muted" Text="{Binding Image}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
