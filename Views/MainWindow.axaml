<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AiBoxDashboard.ViewModels"
        xmlns:c="using:AiBoxDashboard.Controls"
        x:Class="AiBoxDashboard.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="AI Box Dashboard"
        Width="1080" Height="860" MinWidth="820" MinHeight="700">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="PageBrush" Color="#F3F4F6" />
                    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#E1E4E8" />
                    <SolidColorBrush x:Key="MutedBrush" Color="#5B6370" />
                    <SolidColorBrush x:Key="LineBrush" Color="#2C6FBB" />
                    <SolidColorBrush x:Key="AreaBrush" Color="#1F2C6FBB" />
                    <SolidColorBrush x:Key="OnBrush" Color="#1E8E4E" />
                    <SolidColorBrush x:Key="OffBrush" Color="#A9AFB8" />
                    <SolidColorBrush x:Key="ErrorBrush" Color="#B3261E" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="PageBrush" Color="#17191C" />
                    <SolidColorBrush x:Key="CardBrush" Color="#212428" />
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#32363C" />
                    <SolidColorBrush x:Key="MutedBrush" Color="#A3AAB5" />
                    <SolidColorBrush x:Key="LineBrush" Color="#6BB0F5" />
                    <SolidColorBrush x:Key="AreaBrush" Color="#266BB0F5" />
                    <SolidColorBrush x:Key="OnBrush" Color="#4CC47E" />
                    <SolidColorBrush x:Key="OffBrush" Color="#6A717C" />
                    <SolidColorBrush x:Key="ErrorBrush" Color="#F2857D" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="TextBlock.value">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.heading">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.error">
            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="c|Sparkline">
            <Setter Property="Height" Value="44" />
            <Setter Property="Margin" Value="0,10,0,0" />
            <Setter Property="Stroke" Value="{DynamicResource LineBrush}" />
            <Setter Property="Fill" Value="{DynamicResource AreaBrush}" />
        </Style>
        <Style Selector="Ellipse.dot">
            <Setter Property="Width" Value="9" />
            <Setter Property="Height" Value="9" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{DynamicResource OffBrush}" />
        </Style>
        <Style Selector="Ellipse.dot.on">
            <Setter Property="Fill" Value="{DynamicResource OnBrush}" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,*" Background="{DynamicResource PageBrush}">

        <!-- Header: what is being watched, and where to change it -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="20,18,20,0">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding GpuName}" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Classes="muted" Text="{Binding MachineText}" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <StackPanel Spacing="3">
                    <TextBlock Classes="muted" Text="Ollama address" />
                    <TextBox Width="230" Text="{Binding OllamaUrl}" />
                </StackPanel>
                <StackPanel Spacing="3">
                    <TextBlock Classes="muted" Text="SSH host (empty = this machine)" />
                    <TextBox Width="200" Text="{Binding SshHost}" />
                </StackPanel>
                <Button Content="Connect" VerticalAlignment="Bottom" Command="{Binding ApplyConnectionCommand}" />
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="1" Classes="error" Margin="20,10,20,0" Text="{Binding ConnectionError}"
                   IsVisible="{Binding ConnectionError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <!-- GPU readings, each with the last four minutes -->
        <StackPanel Grid.Row="2" Margin="20,14,20,0" Spacing="8">
            <Grid ColumnDefinitions="*,12,*,12,*,12,*">
                <Border Grid.Column="0" Classes="card">
                    <StackPanel>
                        <TextBlock Classes="muted" Text="GPU temperature" />
                        <TextBlock Classes="value" Text="{Binding TemperatureText}" />
                        <TextBlock Classes="muted" Text="scale 0–100 °C" />
                        <c:Sparkline Values="{Binding TemperatureHistory}" Minimum="0" Maximum="100" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Classes="card">
                    <StackPanel>
                        <TextBlock Classes="muted" Text="GPU load" />
                        <TextBlock Classes="value" Text="{Binding UtilizationText}" />
                        <TextBlock Classes="muted" Text="scale 0–100 %" />
                        <c:Sparkline Values="{Binding UtilizationHistory}" Minimum="0" Maximum="100" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Classes="card">
                    <StackPanel>
                        <TextBlock Classes="muted" Text="Video memory in use" />
                        <TextBlock Classes="value" Text="{Binding MemoryText}" />
                        <TextBlock Classes="muted" Text="{Binding MemoryDetail}" />
                        <c:Sparkline Values="{Binding MemoryHistory}" Minimum="0" Maximum="{Binding MemoryTotal}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="6" Classes="card">
                    <StackPanel>
                        <TextBlock Classes="muted" Text="GPU power draw" />
                        <TextBlock Classes="value" Text="{Binding PowerText}" />
                        <TextBlock Classes="muted" Text="last 4 minutes" />
                        <c:Sparkline Values="{Binding PowerHistory}" Minimum="0" Maximum="{Binding PowerMaximum}" />
                    </StackPanel>
                </Border>
            </Grid>
            <TextBlock Classes="error" Text="{Binding GpuMessage}"
                       IsVisible="{Binding GpuMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <!-- The machine itself: CPU, RAM and disks -->
            <Grid ColumnDefinitions="*,12,*,12,*,12,*" Margin="0,4,0,0">
                <Border Grid.Column="0" Classes="card">
                    <StackPanel>
                        <TextBlock Classes="muted" Text="CPU load" />
                        <TextBlock Classes="value" Text="{Binding CpuText}" />
                        <TextBlock Classes="muted" Text="{Binding CpuDetail}" />
                        <c:Sparkline Values="{Binding CpuHistory}" Minimum="0" Maximum="100" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Classes="card">
                    <StackPanel>
                        <TextBlock Classes="muted" Text="RAM in use" />
                        <TextBlock Classes="value" Text="{Binding RamText}" />
                        <TextBlock Classes="muted" Text="{Binding RamDetail}" />
                        <c:Sparkline Values="{Binding RamHistory}" Minimum="0" Maximum="{Binding RamTotal}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Grid.ColumnSpan="3" Classes="card">
                    <Grid RowDefinitions="Auto,Auto,*">
                        <TextBlock Classes="muted" Text="Disks" />
                        <TextBlock Grid.Row="1" Classes="muted" Margin="0,8,0,0" Text="{Binding DisksMessage}"
                                   IsVisible="{Binding DisksMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <ScrollViewer Grid.Row="2" MaxHeight="112" Margin="0,6,0,0">
                            <ItemsControl ItemsSource="{Binding Disks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DiskRow">
                                        <StackPanel Spacing="5" Margin="0,5">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding Mount}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Classes="muted" VerticalAlignment="Center" Text="{Binding UsageText}" />
                                            </Grid>
                                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
            <TextBlock Classes="error" Text="{Binding SystemMessage}"
                       IsVisible="{Binding SystemMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>

        <!-- Models and containers -->
        <Grid Grid.Row="3" ColumnDefinitions="3*,12,2*" Margin="20,14,20,20">
            <Border Grid.Column="0" Classes="card">
                <Grid RowDefinitions="Auto,Auto,*,Auto">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="heading" Text="Models" />
                        <TextBlock Grid.Column="1" Classes="muted" VerticalAlignment="Center" Text="{Binding OllamaStatus}" />
                    </Grid>
                    <TextBlock Grid.Row="1" Classes="muted" TextWrapping="Wrap" Margin="0,10,0,0" Text="{Binding ModelsMessage}"
                               IsVisible="{Binding ModelsMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <ScrollViewer Grid.Row="2" Margin="0,8,0,0">
                        <ItemsControl ItemsSource="{Binding Models}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ModelRow">
                                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,8">
                                        <Ellipse Classes="dot" Classes.on="{Binding IsLoaded}" Margin="0,0,12,0" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Classes="muted" Text="{Binding Details}" />
                                            <TextBlock Classes="muted" Text="{Binding LoadedText}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="12"
                                                       IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                                    Margin="12,0,0,0" IsEnabled="{Binding !IsBusy}"
                                                    IsVisible="{Binding !IsConfirmingDelete}">
                                            <Button Content="{Binding LoadButtonText}" MinWidth="72" HorizontalContentAlignment="Center"
                                                    Command="{Binding ToggleLoadCommand}"
                                                    ToolTip.Tip="Load puts the model into memory so the first answer is fast. Unload frees that memory now." />
                                            <Button Content="Measure speed" Command="{Binding MeasureSpeedCommand}"
                                                    ToolTip.Tip="Generates a short text to measure tokens per second. Loads the model if it is not loaded." />
                                            <Button Content="Delete…" Command="{Binding AskDeleteCommand}"
                                                    ToolTip.Tip="Removes the model from disk, after you confirm." />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                                    Margin="12,0,0,0" IsVisible="{Binding IsConfirmingDelete}">
                                            <TextBlock Text="Delete from disk?" VerticalAlignment="Center" Margin="0,0,4,0" />
                                            <Button Content="Delete" Foreground="{DynamicResource ErrorBrush}"
                                                    Command="{Binding ConfirmDeleteCommand}" />
                                            <Button Content="Keep" Command="{Binding CancelDeleteCommand}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Pull a new model -->
                    <StackPanel Grid.Row="3" Spacing="8" Margin="0,12,0,0">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox Text="{Binding PullName}" PlaceholderText="Model to pull, for example llama3.2:3b"
                                     IsEnabled="{Binding !IsPulling}">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding PullCommand}" />
                                </TextBox.KeyBindings>
                            </TextBox>
                            <Button Grid.Column="1" Content="Pull" Command="{Binding PullCommand}" IsVisible="{Binding !IsPulling}" />
                            <Button Grid.Column="1" Content="Stop" Command="{Binding CancelPullCommand}" IsVisible="{Binding IsPulling}" />
                        </Grid>
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding PullPercent}"
                                     IsIndeterminate="{Binding PullSizeUnknown}" IsVisible="{Binding IsPulling}" />
                        <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding PullStatus}"
                                   IsVisible="{Binding PullStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Classes="card">
                <Grid RowDefinitions="Auto,Auto,*">
                    <TextBlock Classes="heading" Text="Containers" />
                    <TextBlock Grid.Row="1" Classes="muted" TextWrapping="Wrap" Margin="0,10,0,0" Text="{Binding ContainersMessage}"
                               IsVisible="{Binding ContainersMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <ScrollViewer Grid.Row="2" Margin="0,8,0,0">
                        <ItemsControl ItemsSource="{Binding Containers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ContainerRow">
                                    <Grid ColumnDefinitions="Auto,*" Margin="0,8">
                                        <Ellipse Classes="dot" Classes.on="{Binding IsRunning}" Margin="0,0,12,0" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Classes="muted" Text="{Binding Status}" />
                                            <TextBlock Classes="muted" Text="{Binding Image}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
